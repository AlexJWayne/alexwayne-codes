---
import Layout from "../layouts/Layout.astro"
import PageHeading from "../components/PageHeading.astro"

interface Props {
  title: string
}
const { title } = Astro.props
---

<Layout>
  <div class="prose prose-invert prose-h2:font-medium prose-a:transition-colors prose-a:hover:text-indigo-400">
    <PageHeading>{title}</PageHeading>
    <slot />
  </div>
</Layout>
