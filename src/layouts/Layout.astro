---
import BgCanvasWgpu from "../components/bg-canvas-webgpu/BgCanvasWgpu.astro"
import Footer from "../components/Footer.astro"
import "../styles/global.css"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>AlexWayne.codes</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Jura:wght@300..700&family=Lexend:wght@100..900&display=swap");
    </style>
  </head>

  <body class="m-0 min-h-screen bg-linear-to-b from-blue-900 to-sky-950 to-[900px] py-10 font-normal text-blue-100">
    <BgCanvasWgpu />
    <div
      class="relative m-auto w-full max-w-3xl px-6 pb-10 backdrop-blur sm:px-10"
      id="content"
    >
      <h1 class="mt-0 mb-6 font-[Jura] text-[clamp(24px,7.5vw,40px)] leading-[1.2] font-[700] tracking-[-1.2px]">
        <a
          href="/"
          class="text-[#fbad64] no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet-300"
        >
          AlexWayne<span class="text-orange-400">&lt;Codes&gt;</span>
        </a>
      </h1>
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
