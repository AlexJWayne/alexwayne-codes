---
import Layout from "../layouts/Layout.astro"
import GridList from "../components/GridList.astro"
import GridListItem from "../components/GridListItem.astro"

import { getCollection } from "astro:content"

const posts = (await getCollection("posts"))
  .sort(
    (a, b) =>
      (a.data.date || new Date()).getTime() -
      (b.data.date || new Date()).getTime(),
  )
  .reverse()
---

<Layout>
  <p class="m-0 text-base leading-relaxed text-slate-300 sm:text-lg">
    I'm a software engineer{' '}
    <span class="text-orange-300 drop-shadow-dark-glow">
      by day
    </span>,
    <br />
    and also{' '}
    <span class="text-indigo-300 drop-shadow-dark-glow">
      by night.
    </span>
  </p>

  <h2 class="mt-6 text-orange-300 drop-shadow-dark-glow text-lg">By day</h2>
  <p class="text-sm">
    I design and build software across the full stack, including UI/UX,
    design systems, backend systems, complex data models, developer tooling,
    and production infrastructure. I've specialized in TypeScript because I love
    it. I'm the technical lead for a team building software used to construct and
    monitor utility-scale power plants.
  </p>

  <h2 class="mt-6 text-indigo-300 drop-shadow-dark-glow text-lg">By night</h2>
  <p class="text-sm">
    I explore graphics programming, generative art, music, technology in general,
    and whatever else the muse points me toward. Some of the things I make by
    night end up here.
  </p>

  <GridList title="A few of the things I've made">
    {posts.map((post, index) => (
      <GridListItem
        href={`/${post.id}`}
        image={post.data.cover}
        loading={index < 2 ? "eager" : "lazy"}
      >
        {post.data.title}
      </GridListItem>
    ))}
  </GridList>

  <aside
    class="mt-12 grid gap-8 border-t border-white/15 pt-6 text-base leading-relaxed text-slate-300 sm:grid-cols-2 [&_a]:text-blue-100 [&_a]:transition-colors [&_a:hover]:text-violet-300 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4 [&_a:focus-visible]:outline-violet-300"
    aria-label="About me"
  >
    <section>
      <h2 class="mb-3 text-base font-medium">A few of my links</h2>
      <ul class="space-y-1">
        <li>
          <a href="https://github.com/AlexJWayne">GitHub</a>
        </li>
        <li>
          <a href="http://alexwayne.rocks">Music</a>
        </li>
        <li>
          <a
            href="https://stackoverflow.com/users/62076/alex-wayne"
            class="inline-flex flex-col items-start gap-1"
          >
            <span>Stack Overflow</span>
            <img
              src="https://stackoverflow.com/users/flair/62076.png?theme=dark"
              width="208"
              height="58"
              alt="Alex Wayne’s Stack Overflow reputation and badges"
              loading="lazy"
            />
          </a>
        </li>
      </ul>
    </section>
    <section>
      <h2 class="mb-3 text-base font-medium">A few of the things I use</h2>
      <ul class="space-y-1">
        <li>
          <a href="https://svalboard.com/">Svalboard</a> in{" "}
          <strong class="font-medium">Colemak DH</strong>
        </li>
        <li>
          <a href="https://zed.dev">Zed</a> in{" "}
          <a href="https://zed.dev/docs/vim">Vim mode</a>
        </li>
      </ul>
    </section>
  </aside>
</Layout>
