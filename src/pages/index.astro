---
import Layout from "../layouts/Layout.astro"
import GridList from "../components/GridList.astro"
import GridListItem from "../components/GridListItem.astro"

import { getCollection } from "astro:content"

const posts = (await getCollection("posts"))
  .sort(
    (a, b) =>
      (a.data.date || new Date()).getTime() -
      (b.data.date || new Date()).getTime(),
  )
  .reverse()
---

<Layout>
  <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2 sm:gap-y-3 [&_a]:underline [&_a]:text-blue-100 [&_a]:transition-colors [&_a:hover]:text-violet-300 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4 [&_a:focus-visible]:outline-violet-300">
    <section class="grid content-start gap-3 sm:row-span-2 sm:grid-rows-subgrid">
      <h2 class="text-base leading-relaxed text-slate-300 sm:text-lg">
        I'm a software engineer{" "}
        <span class="text-orange-300 drop-shadow-dark-glow">by day.</span>
      </h2>
      <p class="text-sm">
        I design and build software across the full stack, including UI/UX,
        design systems, backend systems, complex data models, developer tooling,
        and production infrastructure. I've specialized in TypeScript because I
        love it. I'm the technical lead for a team building software used to
        construct and monitor{" "}
        <a href="https://solvenergy.com/">utility-scale power plants.</a>
      </p>
    </section>
    <section class="grid content-start gap-3 sm:row-span-2 sm:grid-rows-subgrid">
      <h2 class="text-base leading-relaxed text-slate-300 sm:text-lg">
        And also{" "}
        <span class="text-indigo-300 drop-shadow-dark-glow">by night.</span>
      </h2>
      <p class="text-sm">
        I explore graphics programming, generative art, music, technology in
        general, and whatever else the muse points me toward. Other interests
        have included 3D modeling and animation, visual effects, 3D printing,
        electronics, and PCB design.
        <br />
        <br />
        Some of those things end up here.
      </p>
    </section>
  </div>

  <GridList>
    {posts.map((post, index) => (
      <GridListItem
        href={`/${post.id}`}
        image={post.data.cover}
        loading={index < 2 ? "eager" : "lazy"}
      >
        {post.data.title}
      </GridListItem>
    ))}
  </GridList>
</Layout>
